<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
  <!-- Revamp style tokens (dark theme only), values from research/switcher2/revamp_mockup/mockup.html :root.
       Batch A uses them for the window shell (sidebar, top bar, search). The tab cards keep App.xaml's older tokens
       until batch C moves them here. -->

  <!-- colours -->
  <Color x:Key="ThBgC">#0B0E14</Color>
  <Color x:Key="ThAccentC">#6EA8FF</Color>
  <SolidColorBrush x:Key="ThBg" Color="#0B0E14"/>
  <SolidColorBrush x:Key="ThPanel" Color="#11151D"/>
  <SolidColorBrush x:Key="ThCard" Color="#151A24"/>
  <SolidColorBrush x:Key="ThCard2" Color="#1A2030"/>
  <SolidColorBrush x:Key="ThPopup" Color="#141A27"/>
  <SolidColorBrush x:Key="ThTip" Color="#252D40"/>
  <SolidColorBrush x:Key="ThLine" Color="#232B3B"/>
  <SolidColorBrush x:Key="ThLine2" Color="#2E384D"/>
  <SolidColorBrush x:Key="ThText" Color="#E8ECF4"/>
  <SolidColorBrush x:Key="ThMuted" Color="#8A94A8"/>
  <SolidColorBrush x:Key="ThFaint" Color="#5D6779"/>
  <SolidColorBrush x:Key="ThAccent" Color="#6EA8FF"/>
  <SolidColorBrush x:Key="ThAccentBg" Color="#1F6EA8FF"/>
  <SolidColorBrush x:Key="ThOk" Color="#4ADE9A"/>
  <SolidColorBrush x:Key="ThOkBg" Color="#1A4ADE9A"/>
  <SolidColorBrush x:Key="ThWarn" Color="#F5B94A"/>
  <SolidColorBrush x:Key="ThWarnBg" Color="#1AF5B94A"/>
  <SolidColorBrush x:Key="ThBad" Color="#FF6B6B"/>
  <SolidColorBrush x:Key="ThBadBg" Color="#1AFF6B6B"/>
  <SolidColorBrush x:Key="ThScrim" Color="#B005070B"/>
  <LinearGradientBrush x:Key="ThLogo" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#6EA8FF" Offset="0"/>
    <GradientStop Color="#8B7BFF" Offset="1"/>
  </LinearGradientBrush>

  <!-- shape and spacing -->
  <CornerRadius x:Key="ThRadius">14</CornerRadius>
  <CornerRadius x:Key="ThRadiusMd">12</CornerRadius>
  <CornerRadius x:Key="ThRadiusSm">10</CornerRadius>
  <CornerRadius x:Key="ThRadiusXs">6</CornerRadius>
  <Thickness x:Key="ThCardPad">16</Thickness>
  <Thickness x:Key="ThPagePad">26,22,26,22</Thickness>
  <sys:Double x:Key="ThGap">14</sys:Double>
  <sys:Double x:Key="ThSideWidth">64</sys:Double>
  <sys:Double x:Key="ThTopHeight">60</sys:Double>

  <!-- type -->
  <FontFamily x:Key="ThFont">Segoe UI</FontFamily>
  <sys:Double x:Key="ThFontBody">14</sys:Double>
  <sys:Double x:Key="ThFontSmall">12.5</sys:Double>
  <sys:Double x:Key="ThFontTiny">11</sys:Double>
  <sys:Double x:Key="ThFontTitle">22</sys:Double>

  <!-- ===== shell styles ===== -->

  <!-- sidebar tooltip: dark bubble to the right of the button -->
  <Style x:Key="ThNavTip" TargetType="ToolTip">
    <Setter Property="Placement" Value="Right"/>
    <Setter Property="HorizontalOffset" Value="2"/>
    <Setter Property="Foreground" Value="{StaticResource ThText}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToolTip">
          <Border Background="{StaticResource ThTip}" BorderBrush="{StaticResource ThLine2}" BorderThickness="1"
                  CornerRadius="8" Padding="9,5">
            <ContentPresenter/>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- keyboard focus ring of a sidebar tile (shown for keyboard focus only) -->
  <Style x:Key="ThNavFocus">
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate>
          <Border Margin="9,-1" CornerRadius="13" BorderThickness="1.5" BorderBrush="{StaticResource ThAccent}"/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- sidebar page button: 44 px tile; active = tinted tile + 3 px blue bar on the left edge. The tile grows with the
       rail when it slides open (batch B): the page name (Tag) and its Ctrl+N hint (AutomationProperties.HelpText, set
       by NavTip) are cut off by the tile until then, so the slide needs no extra work per button. -->
  <Style x:Key="ThNav" TargetType="RadioButton">
    <Setter Property="GroupName" Value="Tabs"/>
    <Setter Property="Foreground" Value="{StaticResource ThMuted}"/>
    <Setter Property="Height" Value="44"/>
    <Setter Property="Margin" Value="0,3"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource ThNavFocus}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Grid Background="Transparent">
            <Border x:Name="Bar" Width="3" Height="20" HorizontalAlignment="Left" CornerRadius="0,3,3,0"
                    Background="{StaticResource ThAccent}" Visibility="Hidden"/>
            <Border x:Name="Bd" Height="44" Margin="10,0" CornerRadius="{StaticResource ThRadiusMd}" Background="Transparent"
                    BorderThickness="1" BorderBrush="Transparent" ClipToBounds="True">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="42"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{TemplateBinding Tag}" Foreground="{TemplateBinding Foreground}" FontSize="13.5"
                           VerticalAlignment="Center" Margin="4,0,0,1"/>
                <TextBlock Grid.Column="2" Text="{Binding (AutomationProperties.HelpText), RelativeSource={RelativeSource TemplatedParent}}"
                           Foreground="{StaticResource ThFaint}" FontSize="11" VerticalAlignment="Center" Margin="6,0,10,0"/>
              </Grid>
            </Border>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource ThCard2}"/>
              <Setter Property="Foreground" Value="{StaticResource ThText}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource ThAccentBg}"/>
              <Setter TargetName="Bar" Property="Visibility" Value="Visible"/>
              <Setter Property="Foreground" Value="{StaticResource ThAccent}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- the 20 px stroke icon of the sidebar and the search rows (mockup: 20 px, stroke 1.8) -->
  <Style x:Key="ThIcon" TargetType="Path">
    <Setter Property="Width" Value="24"/>
    <Setter Property="Height" Value="24"/>
    <Setter Property="Stretch" Value="None"/>
    <Setter Property="StrokeThickness" Value="1.8"/>
    <Setter Property="StrokeStartLineCap" Value="Round"/>
    <Setter Property="StrokeEndLineCap" Value="Round"/>
    <Setter Property="StrokeLineJoin" Value="Round"/>
    <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}"/>
    <Setter Property="LayoutTransform">
      <Setter.Value><ScaleTransform ScaleX="0.84" ScaleY="0.84"/></Setter.Value>
    </Setter>
  </Style>

  <!-- top bar status chip: dot + short text -->
  <Style x:Key="ThChip" TargetType="Border">
    <Setter Property="Height" Value="30"/>
    <Setter Property="Padding" Value="11,0"/>
    <Setter Property="Margin" Value="8,0,0,0"/>
    <Setter Property="CornerRadius" Value="15"/>
    <Setter Property="Background" Value="{StaticResource ThCard}"/>
    <Setter Property="BorderBrush" Value="{StaticResource ThLine}"/>
    <Setter Property="BorderThickness" Value="1"/>
  </Style>

  <!-- keyboard hint: "Ctrl K", "Esc" -->
  <Style x:Key="ThKbd" TargetType="Border">
    <Setter Property="BorderBrush" Value="{StaticResource ThLine2}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="{StaticResource ThRadiusXs}"/>
    <Setter Property="Padding" Value="6,0,6,1"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

  <!-- the search field: no box of its own (the outer border draws it) -->
  <Style x:Key="ThSearchText" TargetType="TextBox">
    <Setter Property="Foreground" Value="{StaticResource ThText}"/>
    <Setter Property="CaretBrush" Value="{StaticResource ThAccent}"/>
    <Setter Property="SelectionBrush" Value="{StaticResource ThAccent}"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <ScrollViewer x:Name="PART_ContentHost" Focusable="False" VerticalAlignment="Center"
                        HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- one search result row (reused, never rebuilt): selected = accent tint -->
  <Style x:Key="ThResultRow" TargetType="Border">
    <Setter Property="CornerRadius" Value="{StaticResource ThRadiusSm}"/>
    <Setter Property="Padding" Value="10,8"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Cursor" Value="Hand"/>
  </Style>

  <!-- ===== Overview (batch B): hero, status cards, one-line banners, section head ===== -->

  <Style x:Key="ThHero" TargetType="Border">
    <Setter Property="CornerRadius" Value="16"/>
    <Setter Property="Padding" Value="22,20"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="BorderBrush" Value="{StaticResource ThLine2}"/>
    <Setter Property="Background">
      <Setter.Value>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0.45">
          <GradientStop Color="#16203A" Offset="0"/>
          <GradientStop Color="#151A24" Offset="0.6"/>
        </LinearGradientBrush>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- one status card of the row of four: icon tile + title + one short line -->
  <Style x:Key="ThStatCard" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource ThCard}"/>
    <Setter Property="BorderBrush" Value="{StaticResource ThLine}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="{StaticResource ThRadius}"/>
    <Setter Property="Padding" Value="14"/>
    <Setter Property="Margin" Value="0,0,14,0"/>
  </Style>

  <Style x:Key="ThIco" TargetType="Border">
    <Setter Property="Width" Value="38"/>
    <Setter Property="Height" Value="38"/>
    <Setter Property="CornerRadius" Value="11"/>
    <Setter Property="Background" Value="{StaticResource ThAccentBg}"/>
  </Style>

  <Style x:Key="ThStatTitle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="15"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{StaticResource ThText}"/>
  </Style>
  <Style x:Key="ThStatLine" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{StaticResource ThFontSmall}"/>
    <Setter Property="Foreground" Value="{StaticResource ThMuted}"/>
    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
  </Style>

  <!-- a text link button ("Remove", "Change"): underlined, no box -->
  <Style x:Key="ThLink" TargetType="Button">
    <Setter Property="Foreground" Value="{StaticResource ThText}"/>
    <Setter Property="FontSize" Value="{StaticResource ThFontSmall}"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <TextBlock x:Name="T" Text="{TemplateBinding Content}" TextDecorations="Underline" Background="Transparent"/>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="T" Property="Foreground" Value="{StaticResource ThAccent}"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="T" Property="Foreground" Value="{StaticResource ThFaint}"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- one-line banner: warn (yellow) or note (blue); the code sets the tone -->
  <Style x:Key="ThBanner" TargetType="Border">
    <Setter Property="CornerRadius" Value="{StaticResource ThRadiusMd}"/>
    <Setter Property="Padding" Value="14,9"/>
    <Setter Property="Margin" Value="0,0,0,8"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Background" Value="{StaticResource ThAccentBg}"/>
    <Setter Property="BorderBrush" Value="#306EA8FF"/>
  </Style>
  <SolidColorBrush x:Key="ThWarnLine" Color="#40F5B94A"/>
  <SolidColorBrush x:Key="ThNeedLine" Color="#55F5B94A"/>

  <!-- section head: "ACTIVE MODS · 11" -->
  <Style x:Key="ThSec" TargetType="TextBlock">
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Foreground" Value="{StaticResource ThFaint}"/>
    <Setter Property="Typography.Capitals" Value="AllSmallCaps"/>
    <Setter Property="Margin" Value="0,20,0,10"/>
  </Style>

  <Style x:Key="ThGroupHead" TargetType="TextBlock">
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="Foreground" Value="{StaticResource ThFaint}"/>
    <Setter Property="Margin" Value="10,8,10,4"/>
    <Setter Property="Typography.Capitals" Value="AllSmallCaps"/>
  </Style>
</ResourceDictionary>
