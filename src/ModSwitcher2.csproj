<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>SBGModSwitcher</AssemblyName>
    <RootNamespace>ModSwitcher2</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>2.0.9</Version>
    <ApplicationIcon>logo\app.ico</ApplicationIcon>
    <Product>SBG Mod Switcher</Product>
    <TieredPGO>true</TieredPGO>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <!-- dotnet build = our dev Switcher with all mods: "SBG Switcher DEV" in the title, SBGSwitcherDev.exe (Task Manager
       tells the two apart). dotnet publish (mkrelease tool build, GitHub Actions) = the public installer, title and
       SBGModSwitcher.exe unchanged (2026-10-28). No code or XAML names the
       assembly; the mutex and the AppData folder are fixed strings, so both builds still share them on purpose -->
  <PropertyGroup Condition="'$(_IsPublishing)' != 'true'">
    <DefineConstants>$(DefineConstants);SBG_DEV</DefineConstants>
    <AssemblyName>SBGSwitcherDev</AssemblyName>
  </PropertyGroup>

  <!-- Two public builds from one source (2026-11-19): `-p:SbgNexus=true` = the Nexus build. Nexus does not allow an exe
       that sends or downloads, so that build defines SBG_NEXUS and does not even compile the update code (no HttpClient,
       no Updater). Without it = the GitHub build with the Update button. The release check scans the built exe for network code. -->
  <PropertyGroup Condition="'$(SbgNexus)' == 'true'">
    <DefineConstants>$(DefineConstants);SBG_NEXUS</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(SbgNexus)' == 'true'">
    <Compile Remove="Updater.cs;UpdateHelper.cs;UpdateCli.cs" />
  </ItemGroup>

  <!-- One exe, no clrgc.dll (2.0.6): the default GC kept ~895 MB after a status check only because the check held whole
       90 MB wads in arrays. Mods.UnpackedSha and Mods.VoiceCount now read them as a stream (~166 MB after a check). -->

  <ItemGroup>
    <!-- The app logo (switcher-identity): window icon (set in code) and sidebar picture -->
    <Resource Include="logo\app.ico" />
    <Resource Include="logo\logo_72.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- One source with the old Switcher: LZ4, wad size table, King voice scan -->
    <Compile Include="..\switcher\GowrTools.cs" Link="GowrTools.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- The loader chain's files, built into the exe (2.0.4.1): a player's folder has no versions\ folder, so the chain
         failed for every pack with the loader on. Loader.SourceBytes reads these when the data folder has no copy. -->
    <EmbeddedResource Include="loader\sbg_hook_color_v1.lua" LogicalName="loader/sbg_hook_color_v1.lua" />
    <EmbeddedResource Include="loader\live_public.lua" LogicalName="loader/live_public.lua" />
    <EmbeddedResource Include="loader\probe_stub_v20.lua" LogicalName="loader/probe_stub_v20.lua" />
    <EmbeddedResource Include="loader\probe_tail_v115.lua" LogicalName="loader/probe_tail_v115.lua" />
  </ItemGroup>

</Project>
